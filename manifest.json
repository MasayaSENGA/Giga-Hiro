{
  "manifest_version": 3,
  "name": "ギガひろ",
  "version": "3.2",
  "description": "ギガファイル便の保持期限を自動設定します。",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gigafile.nu/*",
    "https://gigafile.jp/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gigafile.nu/*","https://gigafile.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action":{
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
}