{
  "manifest_version": 3,
  "name": "ギガひろ",
  "version": "4.0.1",
  "description": "ギガファイル便の保持期限とギガワタスの保存日数を自動設定します。",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://gigafile.nu/*","https://gigafile.jp/*"],
      "js": ["settings.js", "content-gigafile.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://giga-watasu.jp/*"],
      "js": ["settings.js", "content-gigawatasu.js"],
      "run_at": "document_idle"
    }
  ],
  "action":{
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
}